# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5001
# Any long random text. Keeps users logged in across server restarts.
SECRET_KEY=change_me_to_a_long_random_string
# Where the React app runs (comma-separate several URLs)
CLIENT_URL=http://localhost:5173
# Optional: use a different database (default is a local SQLite file)
# DATABASE_URL=sqlite:///neurocheck.db
